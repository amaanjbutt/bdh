DATABASE_URL=postgresql://bangladata:bangladata@localhost:5432/bangladata
REDIS_URL=redis://localhost:6379/0
RAW_ARCHIVE_DIR=./data/raw
PUBLIC_BASE_URL=http://localhost:8080
SCRAPER_USER_AGENT=BanglaDataBot/1.0 (+https://bangladatahub.com; data@bangladatahub.com)

# Cloudflare R2 raw archive (optional; local archive is always written)
R2_ENDPOINT=https://523c22b85fb2a47973601da83ab9e647.r2.cloudflarestorage.com
R2_BUCKET=bangladeshdatahub-raw
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# Browser-assisted downloads for F5-protected BB files (requires Chrome/Chromium)
# BROWSER_FETCH=1
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Some government hosts serve incomplete certificate chains; these are public
# data sources, so verification is disabled only for the listed hosts.
# INGEST_INSECURE_HOSTS=bbs.gov.bd,old.dsebd.org,epb.gov.bd,tcb.gov.bd,dam.gov.bd,btrc.gov.bd,berc.org.bd,mra.gov.bd,mof.gov.bd

# Optional relay Worker for hosts that only answer Cloudflare's network
# FETCH_RELAY_URL=https://bangladata-relay.example.workers.dev
# FETCH_RELAY_KEY=

# Billing (LemonSqueezy)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_DEVELOPER=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_BUSINESS=

# Google sign-in + transactional email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
RESEND_API_KEY=
EMAIL_FROM=BanglaDataHub <noreply@bangladatahub.com>
ADMIN_EMAILS=amaanjbutt@gmail.com
