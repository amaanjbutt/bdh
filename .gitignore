# --- secrets: never commit ---
secrets.md
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
*_ed25519*
client_secret_*.json

# --- local-only working files (DB dumps, source PDFs, load outputs, scratch) ---
local/
backups/
*.dump
*.dump.gz
.deploy_bak/
vintage_sources/

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- backend runtime data (the only committed data is backend/data/reference + dq_manual_verdicts.json) ---
backend/data/*
!backend/data/reference/
!backend/data/dq_manual_verdicts.json
data/raw/
dump.rdb

# --- frontend ---
node_modules/
frontend/.output/
frontend/.tanstack/
frontend/.wrangler/
frontend/.nitro/
frontend/.vinxi/
frontend/dist/
frontend/.dev.vars
frontend/.env
frontend/*.local

# --- editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.log

# --- Claude Code: keep the shared launch config, not personal permission lists ---
.claude/*
!.claude/launch.json

# --- frontend outputs GENERATED by frontend/scripts/build-llms.mjs on every dev/build ---
# (live-counts.json + sitemap-core.xml + sitemap-series.xml stay committed: offline fallbacks)
frontend/public/docs/
frontend/public/blog/
frontend/public/llms.txt
frontend/public/llms-full.txt
frontend/public/AGENTS.md
frontend/public/changelog.xml
frontend/public/sitemap-docs.xml
frontend/public/sitemap-blog.xml
frontend/public/sitemap-explorers.xml
frontend/public/sitemap-topics.xml
